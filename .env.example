# Copy to .env and fill in. NEVER commit .env.
#
# Everything here is OPTIONAL. With no keys set, the agent runs fully in
# safe/offline mode: deterministic verdicts still work, message drafts fall back
# to templates, and nothing is sent to a real party.

# Message wording: the agent uses built-in, mood-aware templates by default — no
# model, no API needed. The keys below are OPTIONAL: set one only if you later want
# an LLM to write the messages instead (then `pip install` that SDK too).
ANTHROPIC_API_KEY=                # optional — LLM-written messages via Claude
OPENAI_API_KEY=                   # optional — only if you map a task to "openai"

# Operator approval gate (mirrors store-tester). Over-threshold repairs, formal
# notices, and human escalations wait here for a one-tap Approve/Reject.
TELEGRAM_BOT_TOKEN=...:...
TELEGRAM_CHAT_ID=...

# Safety switch. "1" (default) = never send a real message to a party; log only.
# Set to "0" ONLY when you are ready for the agent to actually message people.
COMMS_DRY_RUN=1

# WhatsApp channel (no paid API — drives WhatsApp Web in a browser).
#   mock (default) = no browser; outbound goes to the console, inbound is injected
#                    via `python main.py simulate ...`. Everything runs offline.
#   live           = real WhatsApp Web. Needs `pip install selenium` + Chrome.
#                    First run shows a QR to scan with your phone (once).
# To actually text people: set WHATSAPP_MODE=live AND COMMS_DRY_RUN=0.
WHATSAPP_MODE=mock
WHATSAPP_PROFILE_DIR=            # optional: where to keep the logged-in browser profile
